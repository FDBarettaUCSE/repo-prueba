# Configuración de variables de entorno para Gestock

# Clave secreta para la firma de tokens JWT (requerido para iniciar la API).
# Generar una segura, por ejemplo con: openssl rand -base64 48
JWT_SECRET=super_secreto_desarrollo_gestock_2026_cambiar_en_produccion

# URI de conexión a MongoDB (usado por la API fuera de docker-compose)
MONGO_URI=mongodb://localhost:27017

# Credenciales para el administrador inicial generado automáticamente si la base de datos está vacía.
# Obligatorias en ese caso (sin valores por defecto, la API no arranca sin ellas).
# Completar con valores propios; la contraseña debe tener entre 8 y 64 caracteres.
INITIAL_ADMIN_EMAIL=admin@gestock.com
INITIAL_ADMIN_PASSWORD=
